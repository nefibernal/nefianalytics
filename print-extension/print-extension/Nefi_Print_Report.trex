<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="io.github.nefibernal.printreport" extension-version="0.1.2">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Print a configured Tableau table as a paginated PDF with dashboard filters and the actual data-refresh timestamp.</description>
    <author name="Nefi Bernal" email="" organization="Nefi Analytics" website="https://nefibernal.github.io/nefianalytics/print-extension/README.html"/>
    <min-api-version>1.10</min-api-version>
    <source-location><url>https://nefibernal.github.io/nefianalytics/print-extension/index.html</url></source-location>
    <icon></icon>
    <context-menu><configure-context-menu-item/></context-menu>
  </dashboard-extension>
  <resources><resource id="name"><text locale="en_US">Nefi Print Report</text></resource></resources>
</manifest>
