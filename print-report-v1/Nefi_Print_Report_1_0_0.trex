<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="io.github.nefibernal.printreport.fresh.v1" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Print a selected table as a paginated PDF in the configured Portrait or Landscape orientation.</description>
    <author name="Nefi Bernal" email="" organization="Nefi Analytics" website="https://nefibernal.github.io/nefianalytics/print-report-v1/"/>
    <min-api-version>1.10</min-api-version>
    <source-location><url>https://nefibernal.github.io/nefianalytics/print-report-v1/extension.html?build=1.0.0</url></source-location>
    <icon></icon>
    <context-menu><configure-context-menu-item/></context-menu>
  </dashboard-extension>
  <resources><resource id="name"><text locale="en_US">Nefi Print Report - Fresh Build 1.0.0</text></resource></resources>
</manifest>
