<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <viz-extension id="com.nefianalytics.quick-kpi-card" version="1.0.1">
    <name resource-id="name" />
    <description>Quick KPI Card displays two aggregated measures in a configurable KPI card.</description>
    <author name="Nefi Bernal" email="nefibernal@users.noreply.github.com" website="https://github.com/nefibernal/nefianalytics" />
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://nefibernal.github.io/nefianalytics/quick-kpi-card/index.html</url>
    </source-location>
    <encoding id="metric1" name="Metric 1" type="quantitative" role="continuous-measure" />
    <encoding id="metric2" name="Metric 2" type="quantitative" role="continuous-measure" />
  </viz-extension>
  <resources>
    <resource id="name"><text locale="en_US">Quick KPI Card</text></resource>
  </resources>
</manifest>
