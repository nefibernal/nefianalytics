<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.nefianalytics.quick-kpi-card" extension-version="1.0.5">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Quick KPI Card displays two aggregated measures in a configurable KPI card.</description>
    <author name="Nefi Bernal" email="nefibernal@users.noreply.github.com" organization="Nefi Analytics" website="https://github.com/nefibernal/nefianalytics"/>
    <min-api-version>1.1</min-api-version>
    <source-location>
      <url>https://nefibernal.github.io/nefianalytics/quick-kpi-card/index.html</url>
    </source-location>
    <icon/>
    <encoding id="metric1">
      <display-name>Primary Metric</display-name>
      <data-spec><data-type>numeric</data-type></data-spec>
      <role-spec><role-type>continuous-measure</role-type></role-spec>
      <fields max-count="1"/>
    </encoding>
    <encoding id="metric2">
      <display-name>Secondary Metric</display-name>
      <data-spec><data-type>numeric</data-type></data-spec>
      <role-spec><role-type>continuous-measure</role-type></role-spec>
      <fields max-count="1"/>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">Quick KPI Card</text></resource>
  </resources>
</manifest>
